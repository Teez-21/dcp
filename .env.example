# Copia este archivo como .env.local y rellena sólo los valores del proyecto Supabase.
# La clave publishable/anon es pública por diseño; no uses service_role ni sb_secret_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: plan gratuito de Geoapify para buscar direcciones/lugares externos.
# La clave se incorpora al JavaScript público; restríngela por dominio en Geoapify.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
